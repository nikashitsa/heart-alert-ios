    "Make sure that you put it on and the battery level is good.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ujistěte se, že máte snímač nasazený a jeho baterie je dostatečně nabitá."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Achten Sie darauf, dass der Sensor angelegt und der Akku ausreichend geladen ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asegúrate de llevar puesto el sensor y de que tenga suficiente batería."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Varmista, että sykevyö on päälläsi ja sen akussa on virtaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez que le capteur est bien porté et que sa batterie est suffisamment chargée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पक्का करें कि आपने सेंसर पहना है और उसकी बैटरी पर्याप्त है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Győződj meg róla, hogy viseled a pulzusmérőt, és az akkumulátora fel van töltve."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastikan sensor sudah dipakai dan baterainya cukup."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Assicurati di indossare il sensore e che la batteria sia sufficientemente carica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "センサーを装着していること、バッテリー残量が十分あることを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "센서를 착용했는지, 배터리가 충분한지 확인하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sørg for at du har på deg pulsbeltet og at batteriet er ladet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zorg ervoor dat je de sensor draagt en dat de batterij voldoende is opgeladen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Upewnij się, że czujnik jest założony, a jego bateria naładowana."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique se você está usando o sensor e se a bateria está carregada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Certifique-se de que colocou o sensor e de que a bateria tem carga suficiente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Убедитесь, что датчик надет и его батарея заряжена."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepričajte se, da ste senzor nadeli in da je baterija dovolj napolnjena."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Se till att du har på dig pulsbandet och att batteriet är laddat."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบว่าคุณสวมเซ็นเซอร์แล้วและแบตเตอรี่ยังเพียงพอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensörü taktığınızdan ve pilinin yeterli olduğundan emin olun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переконайтеся, що датчик надіто, а його батарею заряджено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请确认已佩戴设备且电量充足。"
          }
        }
      }
    },
