    "Your free sessions are complete.\nKeep monitoring with unlimited access.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezplatné relace jsou vyčerpány.\nPokračujte v monitorování s neomezeným přístupem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre kostenlosen Sitzungen sind aufgebraucht.\nÜberwachen Sie weiter mit unbegrenztem Zugang."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has usado todas tus sesiones gratuitas.\nSigue monitorizando con acceso ilimitado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmaiset kertasi on käytetty.\nJatka seurantaa rajattomalla käytöllä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos séances gratuites sont épuisées.\nContinuez le suivi avec l'accès illimité."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके मुफ़्त सेशन पूरे हो गए हैं।\nअसीमित एक्सेस के साथ मॉनिटरिंग जारी रखें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az ingyenes alkalmaid elfogytak.\nFolytasd a monitorozást korlátlan hozzáféréssel."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesi gratis Anda telah habis.\nLanjutkan pemantauan dengan akses tanpa batas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai esaurito le sessioni gratuite.\nContinua il monitoraggio con l'accesso illimitato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料セッションが終了しました。\n無制限アクセスでモニタリングを続けましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 세션을 모두 사용했습니다.\n무제한 이용으로 계속 모니터링하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratisøktene dine er brukt opp.\nFortsett overvåkingen med ubegrenset tilgang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je gratis sessies zijn op.\nBlijf monitoren met onbeperkte toegang."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Darmowe sesje zostały wykorzystane.\nKontynuuj monitorowanie z nieograniczonym dostępem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas sessões gratuitas acabaram.\nContinue monitorando com acesso ilimitado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As suas sessões gratuitas terminaram.\nContinue a monitorizar com acesso ilimitado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бесплатные сессии закончились.\nПродолжайте отслеживание с безлимитным доступом."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše brezplačne seje so porabljene.\nNadaljujte spremljanje z neomejenim dostopom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina gratispass är slut.\nFortsätt övervaka med obegränsad åtkomst."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เซสชันฟรีของคุณหมดแล้ว\nติดตามต่อด้วยการเข้าถึงแบบไม่จำกัด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücretsiz oturumlarınız tamamlandı.\nSınırsız erişimle takibe devam edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Безкоштовні сесії закінчилися.\nПродовжуйте моніторинг із безлімітним доступом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费次数已用完。\n解锁无限次使用，继续监测心率。"
          }
        }
      }
    },
    "Your purchase is pending. Access unlocks once payment completes.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nákup čeká na zpracování. Přístup se odemkne po dokončení platby."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Kauf wird bearbeitet. Der Zugang wird freigeschaltet, sobald die Zahlung abgeschlossen ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu compra está pendiente. El acceso se desbloqueará cuando se complete el pago."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostoksesi odottaa käsittelyä. Käyttö avautuu, kun maksu on valmis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre achat est en attente. L'accès sera débloqué une fois le paiement effectué."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी खरीदारी प्रोसेस हो रही है। भुगतान पूरा होते ही एक्सेस मिल जाएगा।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A vásárlás függőben van. A hozzáférés a fizetés teljesülése után nyílik meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembelian Anda sedang diproses. Akses terbuka setelah pembayaran selesai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo acquisto è in attesa. L'accesso verrà sbloccato al completamento del pagamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入を処理中です。支払いが完了するとアクセスが有効になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매를 처리 중입니다. 결제가 완료되면 이용할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjøpet ditt behandles. Tilgangen låses opp når betalingen er fullført."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je aankoop is in behandeling. Toegang wordt vrijgegeven zodra de betaling is voltooid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakup oczekuje na realizację. Dostęp zostanie odblokowany po zakończeniu płatności."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua compra está pendente. O acesso será liberado quando o pagamento for concluído."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A sua compra está pendente. O acesso será desbloqueado assim que o pagamento for concluído."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупка обрабатывается. Доступ откроется после завершения оплаты."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš nakup je v obdelavi. Dostop bo odklenjen, ko bo plačilo zaključeno."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt köp behandlas. Åtkomsten låses upp när betalningen är klar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การซื้อของคุณอยู่ระหว่างดำเนินการ จะเข้าถึงได้เมื่อชำระเงินเสร็จสมบูรณ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satın alımınız beklemede. Ödeme tamamlandığında erişim açılacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупка обробляється. Доступ відкриється після завершення оплати."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "购买正在处理中，付款完成后即可解锁。"
          }
        }
      }
    },
