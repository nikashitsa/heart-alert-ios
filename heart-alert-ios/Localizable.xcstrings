    "No previous purchase found.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nebyl nalezen žádný předchozí nákup."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein früherer Kauf gefunden."
